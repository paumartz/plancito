# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Project Settings → API). Sin estas variables la app corre en "modo local":
# los datos quedan guardados solo en el navegador, útil para probar.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Notificaciones push (opcional). Generá las claves con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
